// Resources of velora-files: version info (the menu bar shows FileDescription as the app name), the Velora icon and the Inter UI font.
#include <winver.h>
#include "core/version.h"
#include "ui/resource_ids.h"

IDR_VELORA_ICON RCDATA "../../assets/icon_256.png"
IDR_INTER_FONT RCDATA "../../assets/fonts/InterVariable.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VELORA_VERSION_MAJOR, VELORA_VERSION_MINOR, VELORA_VERSION_PATCH, 0
 PRODUCTVERSION VELORA_VERSION_MAJOR, VELORA_VERSION_MINOR, VELORA_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Velora contributors"
      VALUE "FileDescription", "Files"
      VALUE "FileVersion", VELORA_VERSION
      VALUE "InternalName", "velora-files"
      VALUE "LegalCopyright", "Apache-2.0"
      VALUE "OriginalFilename", "velora-files.exe"
      VALUE "ProductName", "Velora"
      VALUE "ProductVersion", VELORA_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
