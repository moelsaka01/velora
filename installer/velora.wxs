<?xml version="1.0" encoding="UTF-8"?>
<!--
  Velora per-user MSI (WiX v4+). Built by .github/workflows/release.yml:
    wix build installer/velora.wxs -d Version=1.0.0 -d StageDir=dist/stage -o dist/Velora-1.0.0.msi
  Installs under %LOCALAPPDATA%\Programs\Velora without administrator rights. The uninstall restores the Windows desktop first
  (velora-shell exit, then velora-watchdog restore) before any file is removed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Velora" Manufacturer="Velora contributors" Version="$(Version)" UpgradeCode="04071D64-4DCE-4A2E-90EE-A362E6AEC6E3"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Velora is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="VeloraIcon" SourceFile="installer/velora.ico" />
    <Property Id="ARPPRODUCTICON" Value="VeloraIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/moelsaka01/velora" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Velora" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Velora" />
    </StandardDirectory>

    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component Id="ShellExe" Guid="*"><File Id="velora_shell" Source="$(StageDir)/velora-shell.exe" KeyPath="yes" /></Component>
      <Component Id="WatchdogExe" Guid="*"><File Id="velora_watchdog" Source="$(StageDir)/velora-watchdog.exe" KeyPath="yes" /></Component>
      <Component Id="FilesExe" Guid="*"><File Id="velora_files" Source="$(StageDir)/velora-files.exe" KeyPath="yes" /></Component>
      <Component Id="SettingsExe" Guid="*"><File Id="velora_settings" Source="$(StageDir)/velora-settings.exe" KeyPath="yes" /></Component>
      <Component Id="LicenseFile" Guid="*"><File Id="license" Source="LICENSE" KeyPath="yes" /></Component>
      <Component Id="NoticeFile" Guid="*"><File Id="notice" Source="NOTICE" KeyPath="yes" /></Component>
      <Component Id="ThirdPartyFile" Guid="*"><File Id="third_party" Source="THIRD_PARTY_NOTICES.md" KeyPath="yes" /></Component>
      <Component Id="ReadmeFile" Guid="*"><File Id="readme" Source="README.md" KeyPath="yes" /></Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="StartMenuDir">
      <Component Id="StartMenuShortcuts" Guid="*">
        <Shortcut Id="VeloraShortcut" Name="Velora" Target="[INSTALLFOLDER]velora-shell.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="SettingsShortcut" Name="Velora Settings" Target="[INSTALLFOLDER]velora-settings.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="RestoreShortcut" Name="Restore Windows Desktop" Target="[INSTALLFOLDER]velora-watchdog.exe" Arguments="--restore"
                  Description="Brings back the taskbar, wallpaper and window styles if Velora is not responding" />
        <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Velora\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Uninstall: leave Velora Mode, then restore Windows, both before the files go (errors ignored: idempotent, may find nothing). -->
    <CustomAction Id="ExitVelora" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]velora-shell.exe&quot; --exit" Return="ignore" Execute="immediate" />
    <CustomAction Id="RestoreWindows" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]velora-watchdog.exe&quot; --restore" Return="ignore" Execute="immediate" />
    <InstallExecuteSequence>
      <Custom Action="ExitVelora" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RestoreWindows" After="ExitVelora" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Velora" Level="1">
      <ComponentGroupRef Id="Binaries" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
